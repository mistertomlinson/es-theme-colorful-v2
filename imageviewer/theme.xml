<?xml version="1.0"?>
<theme>
  <formatVersion>7</formatVersion>
  <include>./theme_video_base.xml</include>

  <!-- The Screenshots system intentionally keeps its black frame in Video view. -->
  <view name="video" extra="true">
    <!-- Shift the screenshot, halo, and frame left so the frame's right edge matches the gamelist's 1.5% left margin. -->
    <video name="md_video" ifHelpPrompts="true">
      <pos>0.655 0.49</pos>
    </video>
    <video name="md_video" ifHelpPrompts="false">
      <pos>0.655 0.5</pos>
    </video>
    <image name="video_media_halo" ifHelpPrompts="true">
      <pos>0.655 0.49</pos>
    </image>
    <image name="video_media_halo" ifHelpPrompts="false">
      <pos>0.655 0.5</pos>
    </image>

    <image name="video_screenshot_border" extra="true" ifHelpPrompts="true">
      <maxSize>0.66 0.84</maxSize>
      <origin>0.5 0.5</origin>
      <pos>0.655 0.49</pos>
      <zIndex>9</zIndex>
      <path>./../inc/images/backdrop.png</path>
    </image>
    <image name="video_screenshot_border" extra="true" ifHelpPrompts="false">
      <maxSize>0.66 0.86</maxSize>
      <origin>0.5 0.5</origin>
      <pos>0.655 0.5</pos>
      <zIndex>9</zIndex>
      <path>./../inc/images/backdrop.png</path>
    </image>
  </view>
</theme>