<?xml version="1.0"?>
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <colorBlack>060606</colorBlack>
    <colorWhite>fbfbfb</colorWhite>
    <colorGray>888888</colorGray>
    <colorGrayVeryDark>222222</colorGrayVeryDark>
    <colorGrayDark>444444</colorGrayDark>
    <colorGrayMidDark>666666</colorGrayMidDark>
    <colorGrayMidLight>bbbbbb</colorGrayMidLight>
    <colorGrayLight>dddddd</colorGrayLight>
    <colorNeutralContrast>${colorWhite}</colorNeutralContrast>
    <colorNone>00000000</colorNone>
    <opacity0P>00</opacity0P>
    <opacity20P>33</opacity20P>
    <opacity25P>40</opacity25P>
    <opacity40P>66</opacity40P>
    <opacity50P>80</opacity50P>
    <opacity60P>99</opacity60P>
    <opacity75P>c0</opacity75P>
    <opacity80P>cc</opacity80P>
    <opacity100P>ff</opacity100P>
    <imageBlank>./../assets/images/blank_1x1.png</imageBlank>
    <soundScroll>./../assets/sounds/select.wav</soundScroll>
  </variables>

  <!-- Shared Video view for system theme files one directory below the theme root. -->
  <view name="video" extra="true">
    <image name="bgFallback" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <zIndex>0</zIndex>
      <path>./../assets/wall/${system.theme}.png</path>
      <path>./../assets/wall/${system.theme}.jpg</path>
    </image>

    <image name="background" extra="true">
      <size>1 1</size>
      <origin>0 0</origin>
      <pos>0 0</pos>
      <zIndex>1</zIndex>
      <path>./../assets/gamelist_wall/${system.theme}.png</path>
      <path>./../assets/gamelist_wall/${system.theme}.jpg</path>
    </image>

    <image name="logo">
      <maxSize>0.29 0.09</maxSize>
      <origin>0.5 0.5</origin>
      <pos>0.1675 0.09</pos>
      <horizontalAlignment>center</horizontalAlignment>
      <verticalAlignment>center</verticalAlignment>
      <path>./../assets/logos/${system.theme}.png</path>
      <path>./../assets/logos/${system.theme}.svg</path>
      <path>./../assets/logos/us/${system.theme}.png</path>
      <path>./../assets/logos/us/${system.theme}.svg</path>
      <path>./../assets/logos/${system.theme}-${lang}.png</path>
      <path>./../assets/logos/${system.theme}-${lang}.svg</path>
      <zIndex>6</zIndex>
    </image>

    <textlist name="gamelist">
      <origin>0 0</origin>
      <pos>0.015 0.16</pos>
      <size>0.305 0.80</size>
      <fontPath>./../assets/fonts/RobotoCondensed-Regular.ttf</fontPath>
      <fontSize>0.035</fontSize>
      <alignment>left</alignment>
      <horizontalMargin>0.01</horizontalMargin>
      <lineSpacing>1.385</lineSpacing>
      <primaryColor>ffffff80</primaryColor>
      <secondaryColor>ffffff80</secondaryColor>
      <selectorColor>${selectorcolor}</selectorColor>
      <selectedColor>ffffff</selectedColor>
      <scrollSound>${soundScroll}</scrollSound>
      <zIndex>7</zIndex>
    </textlist>

    <textlist name="gamelist" ifHelpPrompts="true">
      <size>0.305 0.72</size>
      <fontSize>0.036</fontSize>
    </textlist>

    <text name="md_description,md_developer,md_genre,md_players,md_publisher,md_playcount,md_lbl_releasedate,md_lbl_publisher">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate,md_lastplayed">
      <visible>false</visible>
    </datetime>

    <video name="md_video" ifHelpPrompts="true">
      <maxSize>0.64 0.82</maxSize>
      <origin>0.5 0.5</origin>
      <pos>0.665 0.49</pos>
      <delay>1.5</delay>
      <effect>none</effect>
      <loops>true</loops>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <zIndex>8</zIndex>
    </video>

    <!-- With help hidden, use the freed bottom space and center media vertically. -->
    <video name="md_video" ifHelpPrompts="false">
      <maxSize>0.64 0.84</maxSize>
      <origin>0.5 0.5</origin>
      <pos>0.665 0.5</pos>
      <delay>1.5</delay>
      <effect>none</effect>
      <loops>true</loops>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <zIndex>8</zIndex>
    </video>
  </view>

</theme>